&CONTROL
  calculation = 'scf'
  prefix = 'silicon'
  outdir = './tmp/'
  pseudo_dir = './pseudos/'
  tprnfor = .true.
  tstress = .true.
/
&SYSTEM
  ibrav = 2
  celldm(1) = 10.2076
  nat = 2
  ntyp = 1
  ecutwfc = 50
  ecutrho = 400
  nbnd = 8
/
&ELECTRONS
  conv_thr = 1.0d-10
  mixing_beta = 0.6
/
ATOMIC_SPECIES
  Si 28.086 Si.pz-vbc.UPF
ATOMIC_POSITIONS (alat)
  Si 0.00 0.00 0.00
  Si 0.25 0.25 0.25
K_POINTS (automatic)
  8 8 8 0 0 0
