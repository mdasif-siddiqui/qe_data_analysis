&CONTROL
  calculation = 'scf'
  prefix = 'aluminium'
  outdir = './tmp/'
  pseudo_dir = './pseudos/'
  tprnfor = .true.
  tstress = .true.
/
&SYSTEM
  ibrav = 2
  celldm(1) = 7.50
  nat = 1
  ntyp = 1
  ecutwfc = 20
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
/
&ELECTRONS
  conv_thr = 1.0d-10
  mixing_beta = 0.7
/
ATOMIC_SPECIES
  Al 26.98 Al.pz-vbc.UPF
ATOMIC_POSITIONS (alat)
  Al 0.00 0.00 0.00
K_POINTS (automatic)
  12 12 12 0 0 0
